# =====================================================================
# ScribMed RO – environment variables
# Copy to .env.local for local development. NEVER commit real secrets.
# All variables are read server-side only (no NEXT_PUBLIC_ variables).
# =====================================================================

# ---- Application -----------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000
# Extra origins allowed for CORS / CSRF origin checks (comma-separated). Usually empty.
ALLOWED_ORIGINS=

# ---- Sessions ---------------------------------------------------------
# REQUIRED in production: at least 32 random characters (e.g. `openssl rand -base64 48`).
SESSION_SECRET=
SESSION_TTL_HOURS=8

# ---- Authentication ---------------------------------------------------
# mock = local scrypt passwords (dev/test only) | cognito = AWS Cognito User Pool
AUTH_PROVIDER=mock
ALLOW_MOCK_AUTH_IN_PRODUCTION=false
COGNITO_REGION=eu-central-1
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
# Only if the app client has a secret:
COGNITO_CLIENT_SECRET=

# ---- Database ---------------------------------------------------------
# memory = in-process store, seeded demo account (dev only) | postgres
DATABASE_PROVIDER=memory
DATABASE_URL=postgres://scribmed:scribmed@localhost:5432/scribmed
DATABASE_SSL=false

# ---- Speech-to-text ---------------------------------------------------
# mock = synthetic Romanian transcripts | azure = Azure AI Speech (fast transcription)
SPEECH_PROVIDER=mock
AZURE_SPEECH_KEY=
# EU region of the Speech resource (verify fast-transcription availability for the region)
AZURE_SPEECH_REGION=westeurope
# Optional custom endpoint, e.g. https://<resource>.cognitiveservices.azure.com
AZURE_SPEECH_ENDPOINT=
AZURE_SPEECH_LOCALE=ro-RO
AZURE_SPEECH_API_VERSION=2024-11-15
AZURE_SPEECH_TIMEOUT_MS=600000
AZURE_SPEECH_DIARIZATION=false

# ---- Clinical note generation ----------------------------------------
# mock = deterministic rule-based generator | bedrock = Claude on Amazon Bedrock
NOTE_PROVIDER=mock
BEDROCK_REGION=eu-central-1
BEDROCK_MODEL_ID=anthropic.claude-sonnet-5-5
# Optional: model retried once if the primary model returns stop_reason "refusal"
BEDROCK_FALLBACK_MODEL_ID=
BEDROCK_MAX_TOKENS=8000
# Optional: low | medium | high (omit to use the model default)
BEDROCK_EFFORT=
BEDROCK_TIMEOUT_MS=180000
# AWS credentials: use an IAM role in production. For local testing only:
# AWS_PROFILE=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# ---- Redaction --------------------------------------------------------
# heuristic = trigger-phrase name/address detector | none = regex identifiers only
NER_PROVIDER=heuristic

# ---- Limits -----------------------------------------------------------
MAX_AUDIO_BYTES=41943040
MAX_TRANSCRIPT_CHARS=200000
MOCK_PROVIDER_LATENCY_MS=600
RATE_LIMIT_TRANSCRIBE_PER_HOUR=30
RATE_LIMIT_GENERATE_PER_HOUR=60
RATE_LIMIT_AUTH_PER_15_MIN=10
